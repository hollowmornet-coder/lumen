# =============================================================
#  LUMEN Backend - Environment Configuration
#  Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#  JANGAN commit file `.env` yang berisi secret asli ke Git.
# =============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (MariaDB / MySQL) ---
# Default setup lokal LUMEN (MariaDB portable, port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lumen_user
DB_PASSWORD=lumen_dev_pass
DB_NAME=lumen_db
DB_CONNECTION_LIMIT=10

# --- Auth ---
# WAJIB diganti di environment production. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- CORS (frontend dev server) ---
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3

# --- Rate limit (endpoint autentikasi) ---
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
